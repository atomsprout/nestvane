<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.nestvane.media">
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="37" />
    <!-- Plays Android/data/dev.nestvane.media/files/test.mp4 of the shared storage with the platform's
         own player, and says in the log how the playing goes: for testing codecs, sound and frame rate. -->
    <application android:label="AAA Media Test" android:theme="@android:style/Theme.Material.NoActionBar"
                 android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
