<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center">
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="h:mm" android:format24Hour="H:mm"
        android:textSize="72sp" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-light"
        android:shadowColor="#66000000" android:shadowDy="2" android:shadowRadius="8" />
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEEE, MMMM d" android:format24Hour="EEEE, MMMM d"
        android:textSize="17sp" android:textColor="#F2FFFFFF"
        android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="6" />
</LinearLayout>
