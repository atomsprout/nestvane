+// Copy the latest posted primary frame as tightly packed, bottom-up RGBA8.
+// Zero means there is no newer readable frame. Other values are frame sequences.
+VG_EXPORT uint64_t gfxstream_guest_display_read(uint64_t after, uint8_t* rgba, size_t capacity, uint32_t* dimensions) {
+    auto* fb = gfxstream::host::FrameBuffer::getFB();
+    return fb ? fb->readGuestDisplay(after, rgba, capacity, dimensions) : 0;
