+uint64_t FrameBuffer::Impl::readGuestDisplay(uint64_t after, uint8_t* rgba, size_t capacity, uint32_t* dimensions) {
+#if GFXSTREAM_ENABLE_HOST_GLES
+    AutoLock lock(m_lock);
+    if (after >= m_guestDisplaySequence || !rgba || !dimensions) return 0;
+
+    auto colorBuffer = findColorBuffer(m_lastPostedColorBuffer);
+    if (!colorBuffer) return 0;
+    const uint32_t width = colorBuffer->getWidth();
+    const uint32_t height = colorBuffer->getHeight();
+    if (!width || !height || width > 4096 || height > 4096) return 0;
+    const uint32_t bytes = width * height * 4;
+    if (capacity < bytes) return 0;
+
+    colorBuffer->touch();
+    auto* gl = colorBuffer->getColorBufferGl();
+    if (!gl || !gl->readPixels(0, 0, width, height, GfxstreamFormat::R8G8B8A8_UNORM, rgba, bytes)) {
+        return 0;
+    }
+    dimensions[0] = width;
+    dimensions[1] = height;
+    return m_guestDisplaySequence;
+#else
+    return 0;
+#endif
+}
