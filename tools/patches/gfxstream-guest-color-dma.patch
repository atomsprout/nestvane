+bool FrameBuffer::Impl::transferGuestColorBufferDma(HandleType handle, int x, int y, int width,
+                                                   int height, GLenum pixelsFormat, GLenum pixelsType,
+                                                   void* pixels, uint32_t pixelsSize, bool readback) {
+    if (!pixels || x < 0 || y < 0 || width <= 0 || height <= 0) return false;
+    const auto format = GetGfxstreamFormat(m_features, pixelsFormat, pixelsType);
+    if (!format) return false;
+    const auto bytesPerPixel = GetBpp(*format);
+    if (!bytesPerPixel || uint64_t(width) * height > pixelsSize / *bytesPerPixel) return false;
+
+    AutoLock mutex(m_lock);
+    auto colorBuffer = std::dynamic_pointer_cast<ColorBuffer>(findColorBuffer(handle));
+    if (!colorBuffer || uint64_t(x) + width > colorBuffer->getWidth() ||
+        uint64_t(y) + height > colorBuffer->getHeight()) return false;
+
+    // A YUV upload can read a different layout than the guest's GL format.
+    // The legacy YUV operations carry their own layout information.
+    if (!readback) {
+        if (IsYuvFormat(colorBuffer->getFormat())) return false;
+        return colorBuffer->updateFromBytes(x, y, width, height, *format, pixels);
+    }
+    colorBuffer->readToBytes(x, y, width, height, *format, pixels, pixelsSize);
+    return true;
