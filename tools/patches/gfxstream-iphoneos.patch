diff --git a/host/gl/glestranslator/egl/egl_os_api_ios.mm b/host/gl/glestranslator/egl/egl_os_api_ios.mm
new file mode 100644
index 0000000000000000000000000000000000000000..25effdfd4f5981886595af019ccd12f51630186b
--- /dev/null
+++ b/host/gl/glestranslator/egl/egl_os_api_ios.mm
@@ -0,0 +1,28 @@
+#include "egl_os_api.h"
+
+#import <QuartzCore/CAMetalLayer.h>
+#import <UIKit/UIKit.h>
+
+EglOS::Engine* EglOS::Engine::createHostInstance() {
+    return getEgl2EglHostInstance(false);
+}
+
+void* nsGetLayer(void* window) {
+    UIView* view = (__bridge UIView*)window;
+    return (__bridge void*)view.layer;
+}
+
+bool nsGetWinDims(void* window, unsigned int* width, unsigned int* height) {
+    UIView* view = (__bridge UIView*)window;
+    if (!view) return false;
+    *width = view.bounds.size.width;
+    *height = view.bounds.size.height;
+    return *width && *height;
+}
+
+bool nsCheckColor(void* window, int colorSize) {
+    CAMetalLayer* layer = (__bridge CAMetalLayer*)nsGetLayer(window);
+    if (![layer isKindOfClass:CAMetalLayer.class]) return false;
+    const int rgbBits = layer.pixelFormat == MTLPixelFormatRGB10A2Unorm ? 30 : 24;
+    return colorSize <= rgbBits;
+}
