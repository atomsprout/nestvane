diff --git a/host/native_window/native_sub_window_ios.mm b/host/native_window/native_sub_window_ios.mm
new file mode 100644
index 0000000000000000000000000000000000000000..eee1b48f11100e97416f5680aa1772cdae38b8ce
--- /dev/null
+++ b/host/native_window/native_sub_window_ios.mm
@@ -0,0 +1,54 @@
+#import <QuartzCore/CAMetalLayer.h>
+#import <UIKit/UIKit.h>
+
+#include "gfxstream/host/native_sub_window.h"
+
+@interface GfxstreamMetalView : UIView
+@end
+
+@implementation GfxstreamMetalView
++ (Class)layerClass { return CAMetalLayer.class; }
+@end
+
+EGLNativeWindowType createSubWindow(FBNativeWindowType parent, int x, int y, int width,
+                                    int height, float scale, SubWindowRepaintCallback,
+                                    void*, int hidden) {
+    if (!parent || width <= 0 || height <= 0 || scale <= 0 || !NSThread.isMainThread) return nullptr;
+
+    UIView* container = (__bridge UIView*)parent;
+    GfxstreamMetalView* view = [[GfxstreamMetalView alloc] initWithFrame:CGRectMake(x, y, width, height)];
+    view.hidden = hidden;
+    view.contentScaleFactor = scale;
+    [container addSubview:view];
+    return (__bridge void*)view;
+}
+
+void destroySubWindow(EGLNativeWindowType window) {
+    UIView* view = (__bridge UIView*)window;
+    if (NSThread.isMainThread) {
+        [view removeFromSuperview];
+        [view release];
+    } else {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [view removeFromSuperview];
+            [view release];
+        });
+    }
+}
+
+int moveSubWindow(FBNativeWindowType parent, EGLNativeWindowType window, int x, int y,
+                  int width, int height, float scale) {
+    if (!parent || !window || width <= 0 || height <= 0 || scale <= 0 || !NSThread.isMainThread) return 0;
+
+    UIView* view = (__bridge UIView*)window;
+    view.frame = CGRectMake(x, y, width, height);
+    view.contentScaleFactor = scale;
+    return 1;
+}
+
+void* getNativeDisplay() { return nullptr; }
+
+void* getMetalLayerFromView(void* window) {
+    UIView* view = (__bridge UIView*)window;
+    return (__bridge void*)view.layer;
+}
