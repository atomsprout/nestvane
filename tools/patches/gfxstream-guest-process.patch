+// Legacy Goldfish uses the process pipe to scope resources across render channels.
+VG_EXPORT uint64_t gfxstream_guest_graphics_process_start() {
+    auto* fb = FrameBuffer::getFB();
+    if (!fb) return 0;
+    constexpr uint64_t firstId = uint64_t{1} << 63;
+    static std::atomic<uint64_t> nextId{firstId};
+    const auto id = nextId.fetch_add(1, std::memory_order_relaxed);
+    if (id < firstId || id == UINT64_MAX) return 0;
+    fb->createGraphicsProcessResources(id);
+    return id;
+}
+
+VG_EXPORT void gfxstream_guest_graphics_process_stop(uint64_t id) {
+    if (auto* fb = FrameBuffer::getFB(); fb && id) fb->signalGuestProcessDead(id);
+}
