+struct GuestRenderPipe {
+    gfxstream::RenderChannelPtr channel;
+    gfxstream::RenderChannel::Buffer pending;
+    size_t offset = 0;
+};
+
 }  // namespace
 
 extern "C" {
 
+// One nonblocking byte stream for a Goldfish opengles connection.
+VG_EXPORT void* gfxstream_guest_pipe_open() {
+    auto channel = sFrontend()->openGuestRenderChannel();
+    return channel ? new GuestRenderPipe{std::move(channel), {}, 0} : nullptr;
+}
+
+VG_EXPORT void gfxstream_guest_pipe_close(void* handle) {
+    std::unique_ptr<GuestRenderPipe> pipe(static_cast<GuestRenderPipe*>(handle));
+    if (pipe) pipe->channel->stop();
+}
+
+VG_EXPORT int64_t gfxstream_guest_pipe_write(void* handle, const uint8_t* bytes, size_t size) {
+    if (!handle || (!bytes && size) || size > 64 * 1024) return -22;
+    if (!size) return 0;
+    auto& pipe = *static_cast<GuestRenderPipe*>(handle);
+    gfxstream::RenderChannel::Buffer buffer;
+    buffer.resize_noinit(size);
+    std::memcpy(buffer.data(), bytes, size);
+    using Result = gfxstream::RenderChannel::IoResult;
+    switch (pipe.channel->tryWrite(std::move(buffer))) {
+        case Result::Ok: return size;
+        case Result::TryAgain: return -11;
+        case Result::Error: return -32;
+        case Result::Timeout: return -11;
+    }
+    return -5;
+}
+
+VG_EXPORT int64_t gfxstream_guest_pipe_read(void* handle, uint8_t* bytes, size_t size) {
+    if (!handle || (!bytes && size)) return -22;
+    if (!size) return 0;
+    auto& pipe = *static_cast<GuestRenderPipe*>(handle);
+    if (pipe.pending.empty()) {
+        using Result = gfxstream::RenderChannel::IoResult;
+        switch (pipe.channel->tryRead(&pipe.pending)) {
+            case Result::Ok: break;
+            case Result::TryAgain: case Result::Timeout: return -11;
+            case Result::Error: return 0;
+        }
+    }
+    const auto count = std::min(size, pipe.pending.size() - pipe.offset);
+    std::memcpy(bytes, pipe.pending.data() + pipe.offset, count);
+    pipe.offset += count;
+    if (pipe.offset == pipe.pending.size()) {
+        pipe.pending.clear();
+        pipe.offset = 0;
+    }
+    return count;
+}
+
+VG_EXPORT uint16_t gfxstream_guest_pipe_poll(void* handle) {
+    if (!handle) return 16;
+    const auto& pipe = *static_cast<const GuestRenderPipe*>(handle);
+    using State = gfxstream::RenderChannel::State;
+    const auto flags = static_cast<unsigned>(pipe.channel->state());
+    const bool readable = !pipe.pending.empty() || (flags & static_cast<unsigned>(State::CanRead));
+    const bool writable = flags & static_cast<unsigned>(State::CanWrite);
+    const bool stopped = flags & static_cast<unsigned>(State::Stopped);
+    return (readable ? 1 : 0) | (writable ? 4 : 0) | (stopped ? 16 : 0);
+}
