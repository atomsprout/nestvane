+    if (!gl || !gl->withFramebuffer([&] {
+            surface = m_guestDisplaySurfaces.copyBoundFramebuffer(width, height);
+            return surface != nullptr;
+        })) {
+        return nullptr;
+    }
+    *sequence = m_guestDisplaySequence;
+    return surface;
+#else
+    (void)after;
+    (void)sequence;
+    (void)finish;
+    return nullptr;
 #endif
 }
 
