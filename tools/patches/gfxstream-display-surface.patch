+bool ColorBufferGl::withFramebuffer(const std::function<bool()>& use) {
+    RecursiveScopedContextBind context(m_helper);
+    if (!context.isOk()) {
+        return false;
+    }
+    waitSync();
+    if (!bindFbo(&m_fbo, m_tex, m_needFboReattach)) {
+        return false;
+    }
+    m_needFboReattach = false;
+    const bool res = use();
+    unbindFbo();
+    return res;
