+
+static int verifyInterpretedBpf() {
+    // Read the first IPv6 byte through the same skb ABI as tethering classifiers.
+    const bpf_insn instructions[] = {
+        {BPF_LDX | BPF_MEM | BPF_W, BPF_REG_2, BPF_REG_1, offsetof(__sk_buff, data), 0},
+        {BPF_LDX | BPF_MEM | BPF_W, BPF_REG_3, BPF_REG_1, offsetof(__sk_buff, data_end), 0},
+        {BPF_ALU64 | BPF_MOV | BPF_X, BPF_REG_4, BPF_REG_2, 0, 0},
+        {BPF_ALU64 | BPF_ADD | BPF_K, BPF_REG_4, 0, 0, 15},
+        {BPF_ALU64 | BPF_MOV | BPF_K, BPF_REG_0, 0, 0, 0},
+        {BPF_JMP | BPF_JGT | BPF_X, BPF_REG_4, BPF_REG_3, 1, 0},
+        {BPF_LDX | BPF_MEM | BPF_B, BPF_REG_0, BPF_REG_2, 14, 0},
+        {BPF_JMP | BPF_EXIT, 0, 0, 0, 0},
+    };
+    const char license[] = "Apache 2.0";
+    union bpf_attr load = {};
+    load.prog_type = BPF_PROG_TYPE_SCHED_CLS;
+    load.insn_cnt = sizeof(instructions) / sizeof(instructions[0]);
+    load.insns = reinterpret_cast<uintptr_t>(instructions);
+    load.license = reinterpret_cast<uintptr_t>(license);
+    unique_fd program(syscall(__NR_bpf, BPF_PROG_LOAD, &load, sizeof(load)));
+    if (!program.ok()) return -errno;
+
+    uint8_t frame[54] = {};
+    frame[12] = 0x86;
+    frame[13] = 0xdd;
+    frame[14] = 0x60;
+    frame[20] = 59;  // No next header.
+    frame[21] = 64;
+    union bpf_attr run = {};
+    run.test.prog_fd = program.get();
+    run.test.data_size_in = sizeof(frame);
+    run.test.data_in = reinterpret_cast<uintptr_t>(frame);
+    if (syscall(__NR_bpf, BPF_PROG_TEST_RUN, &run, sizeof(run)) < 0) return -errno;
+    return run.test.retval == 0x60 ? 0 : -EIO;
+}
